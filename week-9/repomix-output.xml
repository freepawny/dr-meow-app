    {
        if ($this->reservationId === '') {
            throw new \InvalidArgumentException('Reservation ID is required.');
        }
        if ($this->serviceId === '') {
            throw new \InvalidArgumentException('Reservation service ID is required.');
        }
        if ($this->customerId === '') {
            throw new \InvalidArgumentException('Reservation customer ID is required.');
        }
        if ($this->catId === '') {
            throw new \InvalidArgumentException('Reservation cat ID is required.');
        }
        if ($this->serviceMethod === '') {
            throw new \InvalidArgumentException('Reservation service method is required.');
        }
        if ($this->workStatus === '') {
            throw new \InvalidArgumentException('Reservation work status is required.');
        }
        if ($this->totalBill < 0) {
            throw new \InvalidArgumentException('Reservation total bill cannot be negative.');
        }
        if ($this->paymenStatus === '') {
