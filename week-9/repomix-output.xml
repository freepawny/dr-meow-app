        >
            <span className="block font-nunito text-s1 font-black text-primary-700 leading-[28px]">
                {sizeTitle}
            </span>
            <span className="block font-nunito text-b3 text-grey-600 leading-[20px]">
                {description}
            </span>
        </button>
    );
};

