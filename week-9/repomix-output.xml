<file path="app/Views/services/api.ts">
import type { ApiResponse } from "./types";

const API_BASE_URL =
    import.meta.env.VITE_API_BASE_URL || "http://127.0.0.1:8000/api/v1";

/**
 * Universal fetch wrapper for Dr. Meow backend API.
 *
 * @param endpoint - Relative endpoint path (e.g. "/services" or "/health").
 * @param options - Standard RequestInit options.
 * @returns Promise resolving to the standard ApiResponse.
 */
export async function apiRequest<T>(
    endpoint: string,
    options: RequestInit = {}
): Promise<ApiResponse<T>> {
    const url = `${API_BASE_URL.replace(/\/+$/, "")}/${endpoint.replace(/^\/+/, "")}`;

    try {
        const response = await fetch(url, {
            ...options,
            headers: {
                Accept: "application/json",
                ...(options.body ? { "Content-Type": "application/json" } : {}),
                ...options.headers
            }
        });

        const result: ApiResponse<T> = await response.json();

        if (!response.ok || !result.success) {
            const errorMsg =
                result.message || `Request failed with HTTP ${response.status}`;
            throw new Error(errorMsg);
        }

        return result;
    } catch (err: unknown) {
        if (err instanceof Error) {
            throw err;
        }
        throw new Error("Terjadi kesalahan jaringan atau server tidak merespons.", { cause: err });
    }
}
</file>

<file path="app/Views/services/reservationApi.ts">
/* ==========================================================================
   IMPORTS & UTILITIES
   ========================================================================== */
import { apiRequest } from "./api";
import type {
    ApiResponse,
    BackendCustomer,
    CustomerInput,
    BackendCat,
    CatInput,
    BackendReservation,
    ReservationInput
} from "./types";

/* ==========================================================================
   CUSTOMER ENDPOINTS
   ========================================================================== */
/**
 * Retrieve all registered customers from the backend.
 *
 * @returns Promise resolving to an API response containing an array of customer records.
 */
export const getCustomers = (): Promise<ApiResponse<BackendCustomer[]>> => {
    return apiRequest<BackendCustomer[]>("/customers");
};

/**
 * Create a new customer record in the backend.
 *
 * @param data - Customer registration attributes.
 * @returns Promise resolving to the newly created customer entity envelope.
 */
export const createCustomer = (
    data: CustomerInput
): Promise<ApiResponse<BackendCustomer>> => {
    return apiRequest<BackendCustomer>("/customers", {
        method: "POST",
        body: JSON.stringify(data)
    });
};

/* ==========================================================================
   CAT ENDPOINTS
   ========================================================================== */
/**
 * Retrieve all cats belonging to a specific customer.
 *
 * @param customerId - Customer identifier whose cats should be fetched.
 * @returns Promise resolving to an API response containing an array of cat entities.
 */
export const getCustomerCats = (
    customerId: string
): Promise<ApiResponse<BackendCat[]>> => {
    return apiRequest<BackendCat[]>(
        `/customers/${encodeURIComponent(customerId)}/cats`
    );
};

/**
 * Create a new cat record linked to an existing customer.
 *
 * @param data - Cat registration payload.
 * @returns Promise resolving to the newly created cat record envelope.
 */
export const createCat = (data: CatInput): Promise<ApiResponse<BackendCat>> => {
    return apiRequest<BackendCat>("/cats", {
        method: "POST",
        body: JSON.stringify(data)
    });
};

/* ==========================================================================
   RESERVATION ENDPOINTS
   ========================================================================== */
/**
 * Create a new reservation record in the backend.
 *
 * @param data - Reservation booking payload.
 * @returns Promise resolving to the persisted reservation record envelope.
 */
export const createReservation = (
    data: ReservationInput
): Promise<ApiResponse<BackendReservation>> => {
    return apiRequest<BackendReservation>("/reservations", {
        method: "POST",
        body: JSON.stringify(data)
    });
};
</file>

<file path="app/Views/services/serviceApi.ts">
import { apiRequest } from "./api";
import type { ApiResponse, BackendService, ServiceInput } from "./types";

/**
 * Fetch all grooming services from the backend.
 *
 * @param activeOnly - If true, retrieves only services with active status.
 */
export const getServices = (activeOnly: boolean = true): Promise<ApiResponse<BackendService[]>> => {
    const query = activeOnly ? "?active=true" : "";
    return apiRequest<BackendService[]>(`/services${query}`);
};

/**
 * Fetch a single grooming service by ID.
 *
 * @param id - Unique service ID.
 */
export const getServiceById = (id: number): Promise<ApiResponse<BackendService>> => {
    return apiRequest<BackendService>(`/services/${id}`);
};

/**
 * Create a new service in backend storage.
 *
 * @param data - Service attributes payload.
 */
export const createService = (data: ServiceInput): Promise<ApiResponse<BackendService>> => {
    return apiRequest<BackendService>("/services", {
        method: "POST",
        body: JSON.stringify(data)
    });
};

/**
 * Update an existing service in backend storage.
 *
 * @param id - Service ID to update.
 * @param data - Updated service attributes.
 */
export const updateService = (
    id: number,
    data: ServiceInput
): Promise<ApiResponse<BackendService>> => {
    return apiRequest<BackendService>(`/services/${id}`, {
        method: "PUT",
        body: JSON.stringify(data)
    });
};

/**
 * Delete a service by ID.
 *
 * @param id - Service ID to delete.
 */
export const deleteService = (id: number): Promise<ApiResponse<null>> => {
    return apiRequest<null>(`/services/${id}`, {
        method: "DELETE"
    });
};

/**
 * Check backend health status.
 */
export const getHealth = (): Promise<ApiResponse<{ status: string }>> => {
    return apiRequest<{ status: string }>("/health");
};
