    customers,
    cats,
    selectedCustomerId,
    selectedCatId,
    loadingCustomers,
    loadingCats,
    errors,
    onUpdateField
}) => {
    return (
        <div className="flex flex-col gap-4">
            <SelectField
                label="Pilih Profil Pelanggan"
                required
                disabled={loadingCustomers || customers.length === 0}
                leftIcon={<User className="h-4 w-4" />}
