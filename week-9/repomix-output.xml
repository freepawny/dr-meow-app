<file path="app/Views/features/reservation/hooks/useReservationForm.ts">
/* ==========================================================================
   IMPORTS & UTILITIES
   ========================================================================== */
import { useEffect, useState } from "react";
import type { FormEvent } from "react";
import { getServices } from "@/services/serviceApi";
import {
    createCat,
    createCustomer,
    createReservation,
    getCustomerCats,
    getCustomers
} from "@/services/reservationApi";
import type {
    BackendCat,
    BackendCustomer,
    BackendReservation,
    BackendService
} from "@/services/types";
import {
    CAT_BREED_OPTIONS,
    FALLBACK_SERVICES,
    MEDICAL_CONDITION_OPTIONS,
    SERVICE_METHOD_OPTIONS,
    TEMPERAMENT_OPTIONS,
    WEIGHT_PRESET_OPTIONS
} from "../constants";
import type {
    ReservationFormErrors,
    ReservationFormValues,
    ReservationSuccessSummary,
    ReservationWeightTier,
    UpdateReservationFieldFn
} from "../types";
import {
    buildWhatsappConfirmationUrl,
    calculateReservationBill,
    getNextOpenClinicDate,
    resolveWeightTier,
    sanitizePhoneNumber,
    validateReservationForm
} from "../utils/reservationHelpers";

/* ==========================================================================
   TYPES & INTERFACES
   ========================================================================== */
/** Configuration options passed into useReservationForm. */
export interface UseReservationFormOptions {
    /** Controls whether the modal window is open. */
    isOpen: boolean;
    /** Optional pre-selected service ID when launched from pricing card. */
    initialServiceId?: string;
    /** Optional pre-selected cat weight tier. */
    initialWeightTier?: ReservationWeightTier;
    /** Optional callback invoked upon successful booking creation. */
    onReservationSuccess?: (reservation: BackendReservation) => void;
}

/* ==========================================================================
   CUSTOM HOOK
   ========================================================================== */
/**
 * Encapsulates reservation form state, API synchronization, validation, and submission workflow.
 *
 * @param options - Hook configuration options including modal open state and pre-selected values.
 * @returns State properties, field updaters, pricing totals, and submit action handlers.
 */
export const useReservationForm = ({
    isOpen,
    initialServiceId,
    initialWeightTier,
    onReservationSuccess
}: UseReservationFormOptions) => {
    const [services, setServices] = useState<BackendService[]>(FALLBACK_SERVICES);
    const [values, setValues] = useState<ReservationFormValues>(() => ({
        bookingMode: "new",
        selectedServiceId: "complete",
        serviceMethod: SERVICE_METHOD_OPTIONS[0].value,
        notificationH1: true,
        customerName: "",
        phoneNumber: "",
        scheduleDate: getNextOpenClinicDate(),
        timeSlot: "10:00",
        address: "",
        catName: "",
        catBreed: CAT_BREED_OPTIONS[0].value,
        catWeight: "1.5",
        catTemperament: TEMPERAMENT_OPTIONS[0].value,
        medicalHistory: MEDICAL_CONDITION_OPTIONS[0].value,
        selectedCustomerId: "",
        selectedCatId: ""
    }));

    const [existingCustomers, setExistingCustomers] = useState<BackendCustomer[]>(
        []
    );
    const [existingCats, setExistingCats] = useState<BackendCat[]>([]);
    const [loadingCustomers, setLoadingCustomers] = useState<boolean>(false);
    const [loadingCats, setLoadingCats] = useState<boolean>(false);

    const [fieldErrors, setFieldErrors] = useState<ReservationFormErrors>({});
    const [submitError, setSubmitError] = useState<string | null>(null);
    const [isSubmitting, setIsSubmitting] = useState<boolean>(false);
    const [successSummary, setSuccessSummary] =
        useState<ReservationSuccessSummary | null>(null);

    const [prevOpen, setPrevOpen] = useState<boolean>(false);
    if (isOpen !== prevOpen) {
        setPrevOpen(isOpen);
        if (isOpen) {
            setSubmitError(null);
            setFieldErrors({});
            setSuccessSummary(null);

            const nextServiceId =
                initialServiceId && !initialServiceId.startsWith("kandang-")
                    ? initialServiceId
                    : undefined;
            const nextWeight = initialWeightTier
                ? WEIGHT_PRESET_OPTIONS.find((p) => p.tier === initialWeightTier)
                      ?.defaultWeight
                : undefined;

            if (nextServiceId || nextWeight) {
                setValues((prev) => ({
                    ...prev,
                    ...(nextServiceId ? { selectedServiceId: nextServiceId } : {}),
                    ...(nextWeight ? { catWeight: nextWeight } : {})
                }));
            }
        }
    }

    const updateField: UpdateReservationFieldFn = (field, value) => {
        setValues((prev) => ({ ...prev, [field]: value }));
        setFieldErrors((prev) => {
            if (!prev[field]) return prev;
            const next = { ...prev };
            delete next[field];
            return next;
        });
    };

    useEffect(() => {
        if (!isOpen) return;
        let isMounted = true;

        const fetchActiveServices = async () => {
            try {
                const res = await getServices(true);
                if (isMounted && Array.isArray(res.data) && res.data.length > 0) {
                    setServices(res.data);
                    setValues((prev) => ({
                        ...prev,
                        selectedServiceId: res.data.some(
                            (item) => item.id === prev.selectedServiceId
                        )
                            ? prev.selectedServiceId
                            : res.data[0].id
                    }));
                }
            } catch {
                void 0;
            }
        };

        void fetchActiveServices();
        return () => {
            isMounted = false;
        };
    }, [isOpen]);

    useEffect(() => {
        if (!isOpen || values.bookingMode !== "existing") return;
        let isMounted = true;

        const fetchCustomersList = async () => {
            setLoadingCustomers(true);
            try {
                const res = await getCustomers();
                if (isMounted && Array.isArray(res.data)) {
                    setExistingCustomers(res.data);
                    if (res.data.length > 0) {
                        setValues((prev) => ({
                            ...prev,
                            selectedCustomerId:
                                prev.selectedCustomerId || res.data[0].customer_id
                        }));
                    }
                }
            } catch {
                if (isMounted) {
                    setExistingCustomers([]);
                }
            } finally {
                if (isMounted) {
                    setLoadingCustomers(false);
                }
            }
        };

        void fetchCustomersList();
        return () => {
            isMounted = false;
        };
    }, [isOpen, values.bookingMode]);

    useEffect(() => {
        if (
            !isOpen ||
            values.bookingMode !== "existing" ||
            !values.selectedCustomerId
        ) {
            return;
        }
        let isMounted = true;

        const fetchCatsForCustomer = async () => {
            setLoadingCats(true);
            try {
                const res = await getCustomerCats(values.selectedCustomerId);
                if (isMounted && Array.isArray(res.data)) {
                    setExistingCats(res.data);
                    setValues((prev) => ({
                        ...prev,
                        selectedCatId: res.data[0]?.cat_id ?? ""
                    }));
                }
            } catch {
                if (isMounted) {
                    setExistingCats([]);
                    setValues((prev) => ({ ...prev, selectedCatId: "" }));
                }
            } finally {
                if (isMounted) {
                    setLoadingCats(false);
                }
            }
        };

        void fetchCatsForCustomer();
        return () => {
            isMounted = false;
        };
    }, [isOpen, values.bookingMode, values.selectedCustomerId]);

    const activeService =
        services.find((s) => s.id === values.selectedServiceId) ?? services[0];

    const selectedExistingCustomer = existingCustomers.find(
        (c) => c.customer_id === values.selectedCustomerId
    );
    const selectedExistingCat = existingCats.find(
        (cat) => cat.cat_id === values.selectedCatId
    );

    const effectiveWeight: number =
        values.bookingMode === "existing"
            ? (selectedExistingCat?.weight ?? 1.5)
            : Number.parseFloat(values.catWeight) || 1.5;

    const currentWeightTier = resolveWeightTier(effectiveWeight);
    const totalBill = calculateReservationBill(activeService, effectiveWeight);

    const activeMethodOption =
        SERVICE_METHOD_OPTIONS.find((m) => m.value === values.serviceMethod) ??
        SERVICE_METHOD_OPTIONS[0];

    const getWhatsappUrl = (reservationCode?: string): string =>
        buildWhatsappConfirmationUrl({
            reservationCode,
            service: activeService,
            serviceMethod: values.serviceMethod,
            bookingMode: values.bookingMode,
            values,
            existingCustomer: selectedExistingCustomer,
            existingCat: selectedExistingCat,
            effectiveWeight,
            totalBill
        });

    const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
        event.preventDefault();
        setSubmitError(null);

        const validationErrors = validateReservationForm(
            values,
            activeMethodOption.requiresHomeAddress
        );
        setFieldErrors(validationErrors);

        if (Object.keys(validationErrors).length > 0 || !activeService) {
            return;
        }

        setIsSubmitting(true);

        try {
            let finalCustomerId = values.selectedCustomerId;
            let finalCatId = values.selectedCatId;
            let summaryCustomerName = selectedExistingCustomer?.name ?? "";
            let summaryCatName = selectedExistingCat?.name ?? "";
            let summarySchedule = selectedExistingCustomer?.schedule ?? "";

            if (values.bookingMode === "new") {
                const cleanPhone = sanitizePhoneNumber(values.phoneNumber);
                const isoSchedule = `${values.scheduleDate}T${values.timeSlot}:00`;
                const parsedWeight = Number(
                    Number.parseFloat(values.catWeight).toFixed(2)
                );

                const customerRes = await createCustomer({
                    name: values.customerName.trim(),
                    phone_number: cleanPhone,
                    schedule: isoSchedule,
                    address: values.address.trim(),
                    preference_notification: values.notificationH1
                });

                finalCustomerId = customerRes.data.customer_id;
                summaryCustomerName = customerRes.data.name;
                summarySchedule = `${values.scheduleDate} • ${values.timeSlot} WIB`;

                const catRes = await createCat({
                    customer_id: finalCustomerId,
                    name: values.catName.trim(),
                    weight: parsedWeight,
                    breeds: values.catBreed,
                    vital_temperature: null,
                    tempramen: values.catTemperament,
                    medical_history: values.medicalHistory,
                    last_picture: null
                });

                finalCatId = catRes.data.cat_id;
                summaryCatName = catRes.data.name;
            }

            const reservationRes = await createReservation({
                service_id: activeService.id,
                customer_id: finalCustomerId,
                cat_id: finalCatId,
                service_method: values.serviceMethod,
                work_status: "Pending",
                notification_h1: values.notificationH1,
                total_bill: totalBill,
                paymen_status: "Unpaid",
                before_after: {
                    before: null,
                    after: null
                }
            });

            setSuccessSummary({
                reservation: reservationRes.data,
                customerName: summaryCustomerName,
                catName: summaryCatName,
                catWeight: effectiveWeight,
                serviceName: `Grooming ${activeService.name}`,
                scheduleLabel: summarySchedule
            });

            onReservationSuccess?.(reservationRes.data);
        } catch (err: unknown) {
            const rawMessage =
                err instanceof Error
                    ? err.message
                    : "Terjadi kendala saat menyimpan reservasi.";
            const isNetworkOffline =
                rawMessage.toLowerCase().includes("failed to fetch") ||
                rawMessage.toLowerCase().includes("network");

            setSubmitError(
                isNetworkOffline
                    ? "Server backend belum aktif atau tidak terjangkau. Pastikan backend berjalan di port 8000, atau lanjutkan pemesanan instan via WhatsApp."
                    : rawMessage
            );
        } finally {
            setIsSubmitting(false);
        }
    };

    const resetTransientState = () => {
        setSuccessSummary(null);
        setSubmitError(null);
        setFieldErrors({});
    };

    return {
        services,
        values,
        updateField,
        setFieldErrors,
        existingCustomers,
        existingCats,
        loadingCustomers,
        loadingCats,
        activeService,
        effectiveWeight,
        currentWeightTier,
        totalBill,
        requiresHomeAddress: activeMethodOption.requiresHomeAddress,
        fieldErrors,
        submitError,
        isSubmitting,
        successSummary,
        getWhatsappUrl,
        handleSubmit,
        resetTransientState
    };
};
</file>

<file path="app/Views/features/reservation/utils/reservationHelpers.ts">
/* ==========================================================================
   IMPORTS & TYPES
   ========================================================================== */
import type { BackendService } from "@/services/types";
import type {
    ReservationFormErrors,
    ReservationFormValues,
    ReservationWeightTier,
    WhatsappMessagePayload
} from "../types";

/* ==========================================================================
   PRICING & FORMATTING HELPERS
   ========================================================================== */
/**
 * Maps numeric cat weight in kg to the backend pricing tier key.
 *
 * @param weight - Numeric body weight of the cat in kilograms.
 * @returns Matched pricing weight tier (`"<2"`, `">2"`, or `">5"`).
 */
export const resolveWeightTier = (weight: number): ReservationWeightTier => {
    if (weight < 2) return "<2";
    if (weight <= 5) return ">2";
    return ">5";
};

/**
 * Calculates integer total bill for a Reservation based on Service tier_prices and Cat weight.
 *
 * @param service - Selected backend service entity containing pricing tiers.
 * @param weight - Effective cat body weight in kilograms.
 * @returns Total bill amount rounded to the nearest integer.
 */
export const calculateReservationBill = (
    service: BackendService | undefined,
    weight: number
): number => {
    if (!service) return 0;
    const safeWeight = Number.isFinite(weight) && weight > 0 ? weight : 1.5;
    const tier = resolveWeightTier(safeWeight);
    const price = service.tier_prices?.[tier] ?? service.base_price;
    return Math.max(0, Math.round(price));
};

/**
 * Formats an integer amount into Indonesian Rupiah display format.
 *
 * @param amount - Currency amount to format.
 * @returns Formatted currency string without trailing decimal zeroes (e.g. "Rp 55.000").
 */
export const formatIdrCurrency = (amount: number): string => {
    return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        minimumFractionDigits: 0
    })
        .format(amount)
        .replace(",00", "");
};

/* ==========================================================================
   DATE & INPUT SANITIZATION HELPERS
   ========================================================================== */
/**
 * Returns the next open clinic date in YYYY-MM-DD format (skipping Friday holiday).
 *
 * @returns Date string formatted as YYYY-MM-DD for the next available clinic day.
 */
export const getNextOpenClinicDate = (): string => {
    const candidate = new Date();
    candidate.setDate(candidate.getDate() + 1);
    if (candidate.getDay() === 5) {
        candidate.setDate(candidate.getDate() + 1);
    }
    const year = candidate.getFullYear();
    const month = String(candidate.getMonth() + 1).padStart(2, "0");
    const day = String(candidate.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
};

/**
 * Checks whether a YYYY-MM-DD date string falls on Friday (clinic closed day).
 *
 * @param dateStr - Date string formatted as YYYY-MM-DD.
 * @returns True if the target date is a Friday, false otherwise.
 */
export const isFridayDate = (dateStr: string): boolean => {
    if (!dateStr) return false;
    const parts = dateStr.split("-").map(Number);
    if (parts.length !== 3 || parts.some(Number.isNaN)) return false;
    const localDate = new Date(parts[0], parts[1] - 1, parts[2]);
    return localDate.getDay() === 5;
};

/**
 * Strips spaces, dashes, and parentheses from phone input to match backend regex.
 *
 * @param raw - Raw phone number input string.
 * @returns Sanitized phone number containing only numeric digits or optional leading `+`.
 */
export const sanitizePhoneNumber = (raw: string): string => {
    return raw.replace(/[\s\-()]/g, "").trim();
};

/* ==========================================================================
   BUSINESS VALIDATION & WHATSAPP URL BUILDER
   ========================================================================== */
/**
 * Validates reservation form inputs against backend Customer, Cat, and Reservation constraints.
 *
 * @param values - Current form values to validate.
 * @param requiresHomeAddress - Whether home address field is mandatory for the selected method.
 * @returns Object mapping invalid field names to human-readable error messages.
 */
export const validateReservationForm = (
    values: ReservationFormValues,
    requiresHomeAddress: boolean
): ReservationFormErrors => {
    const errors: ReservationFormErrors = {};

    if (values.bookingMode === "existing") {
        if (!values.selectedCustomerId) {
            errors.selectedCustomerId =
                "Pilih pelanggan terdaftar atau gunakan tab Pelanggan Baru.";
        }
        if (!values.selectedCatId) {
            errors.selectedCatId =
                "Pilih data kucing yang terdaftar pada pelanggan ini.";
        }
        return errors;
    }

    if (!values.customerName.trim()) {
        errors.customerName = "Nama lengkap wajib diisi.";
    }

    const cleanPhone = sanitizePhoneNumber(values.phoneNumber);
    if (!cleanPhone) {
        errors.phoneNumber = "Nomor WhatsApp wajib diisi.";
    } else if (!/^\+?[0-9]{10,15}$/.test(cleanPhone)) {
        errors.phoneNumber =
            "Gunakan 10–15 digit angka (contoh: 081234567890).";
    }

    if (!values.scheduleDate) {
        errors.scheduleDate = "Tanggal kedatangan wajib dipilih.";
    } else if (isFridayDate(values.scheduleDate)) {
        errors.scheduleDate =
            "Klinik libur rutin hari Jumat. Pilih hari Sabtu–Kamis.";
    }

    if (!values.address.trim()) {
        errors.address = requiresHomeAddress
            ? "Alamat penjemputan / kunjungan rumah wajib diisi."
            : "Pilih cabang klinik atau isi alamat Anda.";
    }

    if (!values.catName.trim()) {
        errors.catName = "Nama kucing wajib diisi.";
    }

    const parsedWeight = Number.parseFloat(values.catWeight);
    if (!Number.isFinite(parsedWeight) || parsedWeight <= 0) {
        errors.catWeight = "Berat kucing harus lebih dari 0 kg.";
    }

    return errors;
};

/**
 * Builds a pre-formatted WhatsApp confirmation or fallback reservation URL.
 *
 * @param payload - Structured context including reservation code, client data, and pricing.
 * @returns Fully encoded `https://wa.me/` hyperlink with pre-filled message text.
 */
export const buildWhatsappConfirmationUrl = ({
    reservationCode,
    service,
    serviceMethod,
    bookingMode,
    values,
    existingCustomer,
    existingCat,
    effectiveWeight,
    totalBill
}: WhatsappMessagePayload): string => {
    const ownerLabel =
        bookingMode === "existing"
            ? (existingCustomer?.name ?? "-")
            : values.customerName.trim();
    const petLabel =
        bookingMode === "existing"
            ? `${existingCat?.name ?? "-"} (${effectiveWeight} kg)`
            : `${values.catName.trim()} - ${values.catBreed} (${effectiveWeight} kg)`;
    const scheduleText =
        bookingMode === "existing"
            ? (existingCustomer?.schedule ?? "-")
            : `${values.scheduleDate} pukul ${values.timeSlot} WIB`;

    const lines = [
        "Halo Admin DR. MEOWW! Saya ingin konfirmasi reservasi perawatan:",
        reservationCode ? `• Kode Reservasi: *${reservationCode}*` : null,
        `• Paket Layanan: *Grooming ${service?.name ?? ""}*`,
        `• Metode Layanan: *${serviceMethod}*`,
        `• Nama Pemilik: ${ownerLabel}`,
        `• Profil Anabul: ${petLabel}`,
        `• Jadwal: ${scheduleText}`,
        `• Estimasi Biaya: *${formatIdrCurrency(totalBill)}*`
    ]
        .filter(Boolean)
        .join("\n");

    return `https://wa.me/?text=${encodeURIComponent(lines)}`;
};
</file>

